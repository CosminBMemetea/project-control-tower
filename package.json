{
  "name": "project-control-tower",
  "productName": "Project Control Tower",
  "description": "Portfolio governance and reporting for project teams",
  "author": "Cosmin Memetea",
  "homepage": "https://github.com/CosminBMemetea/project-control-tower",
  "license": "MIT",
  "version": "1.0.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate dev && prisma db seed",
    "electron:build-resources": "node scripts/build-electron.mjs",
    "electron:start": "electron .",
    "dist:win": "node scripts/build-electron.mjs && electron-builder --win --publish never && node scripts/verify-electron-package.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.4",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.projectcontroltower.desktop",
    "productName": "Project Control Tower",
    "copyright": "Copyright © 2026 Cosmin Memetea",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/main.js",
      "package.json"
    ],
    "extraResources": [
      { "from": ".next/standalone", "to": "standalone" },
      { "from": ".next/standalone/node_modules", "to": "standalone/node_modules" },
      { "from": "electron/template.db", "to": "template.db" },
      { "from": "prisma/migrations", "to": "migrations", "filter": ["**/migration.sql"] }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Control Tower",
      "artifactName": "Project-Control-Tower-Setup-${version}.${ext}",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerSidebar": "electron/installer-sidebar.bmp",
      "uninstallerSidebar": "electron/installer-sidebar.bmp",
      "installerHeader": "electron/installer-header.bmp",
      "include": "electron/installer.nsh",
      "runAfterFinish": true
    }
  }
}
