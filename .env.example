# Copy this file to .env (`cp .env.example .env`) and adjust as needed.
# Everything below is optional except DATABASE_URL — the app works out of
# the box with just that.

DATABASE_URL="file:./dev.db"

# --- Branding ---------------------------------------------------------
# All optional. The same defaults live in config/app.ts, so you only need
# these if you want to override branding per-deployment without touching
# source (e.g. Docker/Vercel). See the README for details.
# APP_NAME="Project Control Tower"
# APP_DESCRIPTION="Portfolio governance & reporting"
# APP_PRIMARY_COLOR="#2563eb"
# APP_LOGO_URL="/logo.svg"

# Absolute base URL for the app, used to build links sent in Reporting
# Checklist emails and shareable "Copy link" buttons. Also usable
# client-side (NEXT_PUBLIC_) if you need the canonical app URL in the
# browser. Optional — without it, the app infers the correct URL from
# whatever host actually served the request (works out of the box in
# dev). Only set this explicitly once deployed to a fixed domain, or if
# links come out wrong behind a proxy that mangles the Host header.
# NEXT_PUBLIC_APP_URL="https://control-tower.example.com"

# --- Access -------------------------------------------------------------
# Simple shared-password protection for the whole app — suitable for an
# internal demo, not a real auth system. Leave unset (or empty) to keep
# the app open with no login required. When set, every page requires this
# password (except the public /checklist-response/[token] links, which
# stay token-secured and open so external recipients can respond).
# APP_PASSWORD="choose-a-demo-password"

# --- Email (optional) ----------------------------------------------------
# SMTP config to have the app send Reporting Checklist emails itself.
# Without SMTP_HOST set, the app just gives you a "Copy link" and an
# "Open in email app" (mailto:) button instead — no configuration needed,
# works immediately.
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Project Control Tower <you@example.com>"
