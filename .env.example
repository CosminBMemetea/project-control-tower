# Copy this file to .env (`cp .env.example .env`) and adjust as needed.
# Everything below is optional except DATABASE_URL — the app works out of
# the box with just that.

DATABASE_URL="file:./dev.db"

# Branding — all optional. The same defaults live in config/app.ts, so you
# only need these if you want to override branding per-deployment without
# touching source (e.g. Docker/Vercel). See the README for details.
# NEXT_PUBLIC_APP_NAME="Project Control Tower"
# NEXT_PUBLIC_APP_DESCRIPTION="Portfolio governance & reporting"
# NEXT_PUBLIC_APP_PRIMARY_COLOR="#2563eb"
# NEXT_PUBLIC_APP_LOGO_URL="/logo.svg"

# Absolute base URL used to build the Reporting Checklist response link.
# Optional — without it, the app infers the correct URL from whatever host
# actually served the request (works out of the box in dev). Only set this
# explicitly if links come out wrong (e.g. behind a proxy that mangles the
# Host header) or once this is deployed to a fixed domain.
# APP_BASE_URL="https://control-tower.example.com"

# Optional: SMTP config to have the app send Reporting Checklist emails
# itself. Without SMTP_HOST set, the app just gives you a "Copy link" and
# an "Open in email app" (mailto:) button instead — no configuration
# needed, works immediately.
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Project Control Tower <you@example.com>"
