; Custom pages for the Windows installer, wired up through "nsis.include"
; in package.json. The sidebar and header images next to this file are
; generated by scripts/build-icons.mjs.

; electron-builder's assisted installer has no welcome page unless this
; macro exists. The standard finish page (with "Run Project Control Tower")
; is kept as-is.
!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Welcome to ${PRODUCT_NAME} ${VERSION}"
  !define MUI_WELCOMEPAGE_TEXT "Portfolio governance and reporting for your projects: goal coverage, RAG status, risks, health, meetings and reports, in one place.$\r$\n$\r$\nYour data stays on this computer. Upgrading keeps all of it, and a backup is saved automatically before any database update.$\r$\n$\r$\nClick Next to continue."
  !insertmacro MUI_PAGE_WELCOME
!macroend
